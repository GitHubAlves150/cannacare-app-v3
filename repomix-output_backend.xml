// FUNÇÃO GETBYID()
// ================================================================
// Busca um paciente pelo ID
func (s *PatientService) GetByID(id uuid.UUID) (*PatientResponse, error) {
	var patient models.Patient
	if err := s.db.Where("id = ?", id).First(&patient).Error; err != nil {
