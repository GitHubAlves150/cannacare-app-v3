-- ================================================================
-- CANNACARE - SCRIPT COMPLETO DO BANCO DE DADOS
-- ================================================================
-- Versão: 3.0
-- Data: 2026-07-30
-- Descrição: Estrutura completa do banco com multi-tenancy
--            Inclui: tabelas, views, funções, triggers e dados iniciais
-- ================================================================

-- ================================================================
-- 1. HABILITAR EXTENSÃO UUID
-- ================================================================
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- ================================================================
-- 2. FUNÇÃO PARA ATUALIZAR updated_at AUTOMATICAMENTE
-- ================================================================
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- ================================================================
-- 3. TABELA: ASSOCIAÇÕES (MULTI-TENANT)
-- ================================================================
-- Esta é a tabela MESTRA que isola os dados de cada associação.
-- Todas as outras tabelas se vinculam a ela via association_id.
-- ================================================================
CREATE TABLE associations (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(200) NOT NULL,
    cnpj VARCHAR(18) UNIQUE NOT NULL,
    email VARCHAR(200) UNIQUE NOT NULL,
    phone VARCHAR(20),
    address TEXT,
    plan VARCHAR(50) DEFAULT 'basic' CHECK (plan IN ('basic', 'premium', 'enterprise')),
    status VARCHAR(20) DEFAULT 'pending' CHECK (status IN ('pending', 'active', 'suspended', 'cancelled')),
    patient_limit INTEGER DEFAULT 50,
    trial_ends_at TIMESTAMP,
    stripe_customer_id VARCHAR(100),
    subscription_id VARCHAR(100),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    deleted_at TIMESTAMP
);

-- Índices da tabela associations
CREATE INDEX idx_associations_cnpj ON associations(cnpj);
CREATE INDEX idx_associations_email ON associations(email);
CREATE INDEX idx_associations_status ON associations(status);

-- Trigger para updated_at
CREATE TRIGGER update_associations_updated_at 
BEFORE UPDATE ON associations 
FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ================================================================
-- 4. TABELA: USUÁRIOS
-- ================================================================
CREATE TABLE users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    association_id UUID NOT NULL REFERENCES associations(id) ON DELETE CASCADE,
    name VARCHAR(200) NOT NULL,
    email VARCHAR(200) NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    role VARCHAR(50) NOT NULL CHECK (role IN ('admin', 'secretaria', 'acolhimento', 'farmacia', 'coordenacao')),
    is_active BOOLEAN DEFAULT TRUE,
    last_login_at TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    deleted_at TIMESTAMP,
    UNIQUE(email, association_id)
);

CREATE INDEX idx_users_association ON users(association_id);
CREATE INDEX idx_users_email ON users(email);

CREATE TRIGGER update_users_updated_at 
BEFORE UPDATE ON users 
FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ================================================================
-- 5. TABELA: PACIENTES
-- ================================================================
